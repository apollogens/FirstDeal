# Server-only FastAPI origin, without /api/v1/auth.
AUTH_API_URL=http://127.0.0.1:8000
# Browser-accessible backend URL for WebSocket updates (falls back to AUTH_API_URL).
NEXT_PUBLIC_WS_API_URL=ws://127.0.0.1:8000
# Optional behind a reverse proxy: exact public frontend origin.
# AUTH_APP_ORIGIN=https://restore.example.com
# For local dev when both hostnames are used.
# AUTH_APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
