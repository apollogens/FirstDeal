{
  "name": "workspace-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "lint:types": "node scripts/typed-lint.mjs",
    "typecheck": "tsc --noEmit",
    "test:auth": "node scripts/check-auth.mjs",
    "test:history": "node --experimental-strip-types --test tests/history-v2.test.mjs",
    "test:calendar": "node --experimental-strip-types --test tests/calendar-v2.test.mjs",
    "test:portfolio": "playwright test",
    "test:portfolio-data": "node --experimental-strip-types --test tests/portfolio-data.test.mjs",
    "demo:portfolio": "node scripts/portfolio-preview.mjs",
    "test:precision": "playwright test --config playwright.precision.config.ts",
    "test:popover": "node --experimental-strip-types --test tests/popover-position.test.mjs",
    "test:boundaries": "node --experimental-transform-types --import ./tests/helpers/register-ts.mjs --test tests/auth-boundaries.test.mjs tests/task-boundaries.test.mjs tests/chat-boundaries.test.mjs tests/domain-boundaries.test.mjs tests/chat-http-boundaries.test.mjs tests/release-boundaries.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/science-gothic": "^5.3.0",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "next": "16.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "^6.0.3"
  }
}
